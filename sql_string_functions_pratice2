--Q1. Employees andariki emp_name ni uppercase lo display cheyyi.
update employees set emp_name=upper(emp_name);


--Q2. Employees andariki emp_name ni lowercase lo display cheyyi.
update employees set emp_name=lower(emp_name);


--Q3. Prathi employee name yokka length find cheyyi.
select emp_name, length(emp_name) from employees;


--Q4. Employee name tho paatu, first 5 characters display cheyyi.
select left(emp_name,5) from employees;


--Q5. Employee name lo last 4 characters display cheyyi.
select emp_name,right(emp_name,4) from employees;

--Q6. emp_name and city ni combine chesi oka column lo display cheyyi.
