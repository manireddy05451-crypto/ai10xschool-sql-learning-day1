USE college_db;


-- ============================================
-- STUDENTS TABLE
-- ============================================

CREATE TABLE students (
    student_id INT PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    gender VARCHAR(10),
    department VARCHAR(30),
    city VARCHAR(30),
    marks INT
);
