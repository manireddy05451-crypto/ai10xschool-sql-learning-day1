-- ============================================
-- STUDENTS TABLE - CLAUSES PRACTICE
-- ============================================

-- WHERE CLAUSE-----------------------------------------------------------------------

-- 1. Display students whose marks are greater than 80.
select * from students where marks>80;

-- 2. Display students whose age is greater than 20
--    and belong to CSE department.
select * from students where age>20 and department='cse';

-- ORDER BY CLAUSE-----------------------------------------------------------------

-- 3. Display students ordered by marks from highest
--    to lowest.
select * from students order by marks desc;

-- 4. Display students ordered by department A-Z
--    and marks from highest to lowest.
select * from students order by department asc ,marks desc;

-- LIMIT CLAUSE------------------------------------------------------------------

-- 5. Display only the first 5 students.
select * from students limit 5;

-- 6. Display the top 3 students based on highest marks.
select * from students order by marks desc limit 3;

-- DISTINCT CLAUSE----------------------------------------------------------------------

-- 7. Display all unique departments.
select distinct department from students;

-- 8. Display all unique cities.
select distinct city from students;

-- GROUP BY CLAUSE----------------------------------------------------------------------

-- 9. Find the number of students in each department.
select department ,count(*) from students group by department;

-- 10. Find the average marks of each department.
select department ,avg(marks) from students group by department;

-- HAVING CLAUSE------------------------------------------------------------------------

-- 11. Display departments having more than 2 students.
select department, count(*) from students group by department having count(*)>2;

-- 12. Display departments whose average marks
--     are greater than 85.
select department, avg(marks) from students group by department having avg(marks)>2;
